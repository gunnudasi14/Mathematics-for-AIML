    "\[IndentingNewLine]", 
    RowBox[{"matB", "=", 
     RowBox[{"Take", "[", 
      RowBox[{"B1", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "rows"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "columns"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Pane", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Text", "@", 
       RowBox[{"Style", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Column", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<A\>\"", ",", "Italic"}], "]"}], ",", 
                 "\"\< = \>\"", ",", 
                 RowBox[{"MatrixForm", "[", 
                  RowBox[{"{", 
                   RowBox[{"Grid", "[", 
                    RowBox[{"matA", ",", 
                    RowBox[{"Alignment", "\[Rule]", "Right"}], ",", 
                    RowBox[{"Spacings", "\[Rule]", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "0.5"}], "}"}]}]}], "]"}], "}"}], "]"}],
                  ",", "\[IndentingNewLine]", "\"\<, \>\"", ",", " ", 
                 RowBox[{"Spacer", "[", "10", "]"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<B\>\"", ",", "Italic"}], "]"}], ",", 
                 "\"\< = \>\"", ",", 
                 RowBox[{"MatrixForm", "[", 
                  RowBox[{"{", 
                   RowBox[{"Grid", "[", 
                    RowBox[{"matB", ",", 
                    RowBox[{"Alignment", "\[Rule]", "Right"}], ",", 
                    RowBox[{"Spacings", "\[Rule]", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "0.5"}], "}"}]}]}], "]"}], "}"}], 
                  "]"}]}], "}"}], "]"}], "\[IndentingNewLine]", "\"\<\>\""}], 
             ",", "\"\<\>\"", ",", "\"\<\>\"", ",", "\[IndentingNewLine]", 
             RowBox[{"Row", "[", 
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<A\>\"", ",", "Italic"}], "]"}], ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"op", "===", "\"\<add\>\""}], ",", "\"\< + \>\"", 
                  ",", "\"\< - \>\""}], "]"}], ",", 
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<B\>\"", ",", "Italic"}], "]"}], ",", 
                "\"\< = \>\"", ",", "\[IndentingNewLine]", 
                RowBox[{"MatrixForm", "@", 
                 RowBox[{"Transpose", "@", 
                  RowBox[{"Map", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{"\"\<(\>\"", ",", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"op", "===", "\"\<add\>\""}], ",", "\"\< + \>\"", 
                    ",", "\"\< - \>\""}], "]"}], ",", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<)\>\""}], "}"}],
                     "]"}], "&"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"Transpose", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"matA", ",", "matB"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"3", ",", "2", ",", "1"}], "}"}]}], "]"}], ",", 
                    RowBox[{"{", "2", "}"}]}], "]"}]}]}]}], 
               "\[IndentingNewLine]", "}"}], "]"}], ",", 
             "\[IndentingNewLine]", "\"\<\>\"", ",", "\"\< = \>\"", ",", 
