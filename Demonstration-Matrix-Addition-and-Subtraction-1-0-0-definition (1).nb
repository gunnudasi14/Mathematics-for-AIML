Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"matA", "=", 
     RowBox[{"Take", "[", 
      RowBox[{"A1", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "rows"}], "}"}], ",", 
