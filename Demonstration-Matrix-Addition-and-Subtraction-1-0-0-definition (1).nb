      "Body" :> ($CellContext`matA = 
        Take[$CellContext`A1$$, {1, $CellContext`rows$$}, {
          1, $CellContext`columns$$}]; $CellContext`matB = 
        Take[$CellContext`B1$$, {1, $CellContext`rows$$}, {
          1, $CellContext`columns$$}]; Pane[
         Text[
          Style[
           Column[{Row[{
                Style["A", Italic], " = ", 
                MatrixForm[{
                  
                  Grid[$CellContext`matA, Alignment -> Right, 
                   Spacings -> {1, 0.5}]}], ", ", 
                Spacer[10], 
                Style["B", Italic], " = ", 
                MatrixForm[{
                  
                  Grid[$CellContext`matB, Alignment -> Right, 
                   Spacings -> {1, 0.5}]}]}] "", "", "", 
             Row[{
               Style["A", Italic], 
               If[$CellContext`op$$ === "add", " + ", " - "], 
               Style["B", Italic], " = ", 
               MatrixForm[
                Transpose[
                 Map[Row[{"(", 
                    Part[#, 1], 
                    If[$CellContext`op$$ === "add", " + ", " - "], 
                    Part[#, 2], ")"}]& , 
                  
                  Transpose[{$CellContext`matA, $CellContext`matB}, {3, 2, 
                   1}], {2}]]]}], "", " = ", "", 
             MatrixForm[{
               Grid[
                
                If[$CellContext`op$$ === 
                 "add", $CellContext`matA + $CellContext`matB, \
$CellContext`matA - $CellContext`matB], Alignment -> {Right, Bottom}, 
                Spacings -> {1, 0.5}]}]}, Alignment -> Center], 16]], 
